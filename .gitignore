# ==========================================
# macOS System Files
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
._*

# Thumbnails and system cache
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ==========================================
# Obsidian Internal Files
# ==========================================
# Ignore the Obsidian internal trash folder
.trash/

# Ignore the Obsidian cache directory
.obsidian/caches/

# ALWAYS IGNORE workspace UI states to prevent constant merge conflicts
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json

# ==========================================
# Optional: Plugins & Extra Caches
# ==========================================
# Ignore the state file generated by the community git plugin
.obsidian-git-data

# UNCOMMENT BELOW IF YOU DO NOT WANT TO SYNC PLUGINS & THEMES:
# .obsidian/plugins/
# .obsidian/themes/
